# microservice specific routes

->          /hmrc-frontend                  hmrcfrontend.Routes

GET         /                               controllers.Default.redirect(to = "/sdec/thread-reference")

GET         /thread-reference               uk.gov.hmrc.sdeccustomerfrontend.controllers.EnterThreadReferenceController.onPageLoad(mode: Mode = NormalMode)
POST        /thread-reference               uk.gov.hmrc.sdeccustomerfrontend.controllers.EnterThreadReferenceController.onContinue(mode: Mode = NormalMode)

GET         /unauthorised                   uk.gov.hmrc.sdeccustomerfrontend.controllers.UnauthorisedController.onPageLoad()

GET         /development-in-progress        uk.gov.hmrc.sdeccustomerfrontend.controllers.DevelopmentInProgressController.onPageLoad()

GET         /assets/*file                   controllers.Assets.versioned(path = "/public", file: Asset)
